# .env.example — GSI ONE / Avança Hospital Canindé
#
# Copiar este arquivo como .env.local para desenvolvimento local.
# NUNCA commitar .env.local ou qualquer arquivo com valores reais.
#
# Obtidos via: npx supabase status -o env  (ambiente local)
# Para staging/produção: configurar via variáveis de ambiente do CI/CD ou Netlify.

# URL da API do Supabase (local: http://127.0.0.1:54321)
SUPABASE_URL=

# Chave pública anon — pode ser exposta no frontend (leitura limitada por RLS)
SUPABASE_ANON_KEY=

# Chave de serviço — NUNCA expor no frontend ou commitar
# Usada apenas em scripts administrativos e testes de integração locais
# Obtida via: npx supabase status -o env (SERVICE_ROLE_KEY ou SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão direta ao banco PostgreSQL local
# Usada por testes de integração (local-supabase.js via docker exec)
# Formato: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=
